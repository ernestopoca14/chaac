# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored. NEVER commit real credentials.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Fallback hotspot password (used if Wi-Fi is unavailable)
ap_password: "change-me"

# ESPHome API / OTA
api_encryption_key: "generate-with-esphome"
ota_password: "change-me"

# MQTT broker (use authentication; don't expose it directly to the internet)
mqtt_broker: "192.168.1.10"
mqtt_username: "chaac"
mqtt_password: "change-me"
