# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored. NEVER commit real credentials.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Fallback hotspot password (used if Wi-Fi is unavailable, min. 8 characters)
ap_password: "change-me-please"

# ESPHome native API encryption key: generate a new one at
# https://esphome.io/components/api.html (32 random bytes, base64)
api_encryption_key: "generate-your-own-key"

# OTA update password
ota_password: "change-me-please"
